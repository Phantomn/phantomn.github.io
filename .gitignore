# Ignore scratch scripts but keep the CI link-audit gate tracked
# (a bare `scripts/` would make the file impossible to re-include).
scripts/*
!scripts/check-links.mjs
!scripts/check-claims.mjs
!scripts/check-pgp.mjs
# 산출물 5개를 만드는 유일한 경로 - 빠지면 data/source 를 산출물로 바꿀 수 없다
!scripts/generate-from-source.mjs
# 포크 잔재 검사기와 그 예외 등재 목록
!scripts/check-residue.mjs
!scripts/residue-keep.txt
!scripts/build-search-index.mjs
!scripts/check-records.mjs
!scripts/check-i18n.mjs
!scripts/cv
!scripts/cv/**
scripts/cv/rendercv_output/

# Local research / drafts not intended for publication
private/

# Claude Code local state
.claude/

# Coverage profile artefacts
*.profraw

# AI-assisted process artifacts (keep out of the public repo)
docs/superpowers/

